# Product identity used by the build and release scripts. Change the name here and in Sources/DataRecover/Brand.swift.
APP_NAME="Found Again"
# The binary inside the app. No spaces, so command lines stay simple.
EXECUTABLE="FoundAgain"
# Folder name in Support/Icons (without .icon).
ICON="foundagain"
BUNDLE_ID="uk.co.weio.foundagain"
VERSION="2.0"
BUILD="1"
# Download file name, also used by the website's /download page.
DMG_NAME="FoundAgain-$VERSION.dmg"
DEV_IDENTITY="Apple Development: Adam Perry (MJDP35MH5W)"
RELEASE_IDENTITY="Developer ID Application: weio Ltd (H4T6Q9X2TH)"
TEAM_ID="H4T6Q9X2TH"
# Name of the notarytool keychain profile (create once with: xcrun notarytool store-credentials).
NOTARY_PROFILE="weio-notary"
